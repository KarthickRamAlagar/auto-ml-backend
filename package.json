{
  "name": "auto-ml-worker",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../scripts/local-setup.mjs && wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply auto-ml-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply auto-ml-db --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "hono": "^4.13.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@cloudflare/workers-types": "^5.20261010.1",
    "@types/node": "^22.20.5",
    "typescript": "^5.6.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.149.0"
  }
}
